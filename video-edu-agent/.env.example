# Salin file ini menjadi .env dan isi API key kamu

# === PRIMARY LLM ===
# Gemini 2.5 Flash — Gratis di: https://aistudio.google.com
GEMINI_API_KEY=isi_api_key_gemini_di_sini

# === FALLBACK LLM ===
# Groq (Llama 3.3 70B) — Gratis di: https://console.groq.com
GROQ_API_KEY=isi_api_key_groq_di_sini

# === IMAGE GENERATION ===
# Hugging Face (FLUX.1-schnell) — Gratis di: https://huggingface.co/settings/tokens
HF_TOKEN=isi_token_hugging_face_di_sini
